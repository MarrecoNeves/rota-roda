# OPCIONAL. Sem este arquivo o app funciona 100% grátis com OpenStreetMap.
# Para usar o Google Maps (exige cartão cadastrado no Google Cloud), copie para ".env" e preencha.
# NUNCA suba o .env para o GitHub.

# Chave do NAVEGADOR (restrição "Sites": http://localhost:8000/* e https://rota-roda-uff.onrender.com/*).
# APIs: Maps JavaScript API, Places API (New), Geocoding API.
GOOGLE_MAPS_BROWSER_KEY=

# Chave do SERVIDOR (restrição de API: Routes API e Geocoding API).
GOOGLE_MAPS_SERVER_KEY=

# Opcional: Map ID do Google (estilo do mapa). Sem ele usa DEMO_MAP_ID.
GOOGLE_MAPS_MAP_ID=
